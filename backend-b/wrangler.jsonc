{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semantius-copilot-backend-b",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Flue v2 generates one DO class per agent (Flue<Pascal(identity)>Agent).
  // Fresh v1 history: this worker was created 2026-08-04 as the rename of
  // hoth-poc-backend-b (whose v1-v4 migration history is in git); Durable
  // Object state did not carry over, KV does (bound by namespace id below).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SemantiusCopilotSandbox", "FlueMainAgent"] }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandbox", "class_name": "SemantiusCopilotSandbox" }]
  },
  // placement stays "smart" (default) — "targeted" breaks outboundByHost
  // header injection (sandbox-sdk#661, plan §7).
  "containers": [
    {
      "class_name": "SemantiusCopilotSandbox",
      "image": "./Dockerfile",
      // Build context = repo root so the image can COPY the shared semantius
      // CLI from ../linux-x64/ (single binary, no per-backend duplication).
      // Kept small by the repo-root .dockerignore.
      "image_build_context": "..",
      "instance_type": "lite"
    }
  ],
  "kv_namespaces": [
    { "binding": "STORE", "id": "6799aa42675b47148d246feda057a0e5" }
  ],
  // Workspace backup archives (add_backup_restore_plan.md): the sandbox SDK's
  // localBucket backup mode reads this binding off the DO env; the routes,
  // data browser, and sweep use the same one. Bucket must exist before deploy:
  //   wrangler r2 bucket create semantius-copilot-backups
  // Binding absent = feature off everywhere (no crash paths).
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "semantius-copilot-backups" }
  ],
  // Hourly backup sweep (src/cloudflare.ts default-export `scheduled`):
  // deletes R2 backups whose session expired at its silent 24 h KV TTL.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Public API hostname (what app.semantius.com's copilot pages call). A
  // CUSTOM DOMAIN on this worker — not the frontend: attaching it there serves
  // the frontend's 404 page for every API path and no CORS headers at all.
  "routes": [
    { "pattern": "copilot.semantius.com", "custom_domain": true }
  ],
  // Adding `routes` flips wrangler's workers_dev default to false — keep the
  // *.workers.dev URL alive explicitly: the deployed frontend calls it.
  "workers_dev": true,
  // Workers Logs (dashboard "Logs" tab + wrangler tail): needed to attribute
  // container boots — lazy-env.ts logs which operation triggered a boot.
  "observability": {
    "enabled": true
  },
  // Workers AI binding — required when LLM_PROVIDER=cloudflare (no API key needed).
  "ai": { "binding": "AI" },
  "vars": {
    // Account tag for the GraphQL Analytics query behind GET /admin/costs
    // (src/costs.ts). Not a secret — the token is: CLOUDFLARE_API_TOKEN
    // (.dev.vars locally, wrangler secret put when deployed), scoped to
    // Account -> Account Analytics -> Read. No token = costs view says so.
    "CLOUDFLARE_ACCOUNT_ID": "04c687e49e3fd4275f13703979c3f1e3",
    // LLM settings: provider cloudflare | openrouter | custom ("custom" also
    // requires LLM_BASE_URL). The API key is the LLM_API_KEY secret
    // (.dev.vars locally, wrangler secret put when deployed).
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "deepseek/deepseek-v4-flash",
    // Braintrust tracing (src/braintrust.ts): traces land in this project.
    // The API key is the BRAINTRUST_API_KEY secret (.dev.vars locally,
    // wrangler secret put when deployed) — never a vars value. No key = no export.
    "BRAINTRUST_PROJECT_NAME": "semantius-copilot",
    // Arize AX tracing (src/otel.ts): traces land in this Arize project.
    // ARIZE_SPACE_ID + ARIZE_API_KEY are secrets (.dev.vars locally,
    // wrangler secret put when deployed). No secrets = no export.
    "ARIZE_PROJECT_NAME": "semantius-copilot",
    // Better-auth session host for the chat gate's cookie path (core/src/
    // identity.js): GET /session validates a forwarded session cookie, POST
    // /session/token trades it for the Semantius JWT the sandbox acts with.
    // Any org's host validates a session created by any app sharing the same
    // BETTER_AUTH_SECRET and database, so ONE host serves every tenant — the
    // tenant comes from the session's active organization, not from this URL.
    // The exchange key is the JWT_EXCHANGE_API_KEY secret (.dev.vars locally,
    // wrangler secret put when deployed). No key = cookie auth answers 503.
    "SEMANTIUS_SESSION_BASE_URL": "https://api.semantius.cloud",
    // Langfuse tracing (src/otel.ts): OTLP endpoint region. The project is
    // selected by the LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY secrets
    // (.dev.vars locally, wrangler secret put when deployed). No keys = no export.
    "LANGFUSE_BASE_URL": "https://us.cloud.langfuse.com",
    // Browser origins allowed to make CREDENTIALED calls (see Env in
    // src/app.ts): CORS echoes the origin off this list (credentialed mode
    // forbids the wildcard) and the CSRF check accepts form-type posts only
    // from it. MUST contain the frontend Worker's origin, or every chat page
    // loses CORS at deploy time. Add an embedding app's origin here once it
    // runs same-site with this backend (ambient-cookie mode).
    "ALLOWED_ORIGINS": "https://semantius-copilot-frontend.ma532.workers.dev,https://app.semantius.com,http://localhost:5173"
  }
}
