{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoth-poc-backend-b",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Flue v2 generates one DO class per agent (Flue<Pascal(identity)>Agent).
  // The beta-era FlueRegistry class is gone in v2, hence the v3
  // deleted_classes entry (append-only history). v4: the agent was renamed
  // hoth -> main (generic multi-agent host), abandoning pre-rename sessions.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueRegistry", "FlueHothAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["HothSandbox"] },
    { "tag": "v3", "deleted_classes": ["FlueRegistry"] },
    { "tag": "v4", "new_sqlite_classes": ["FlueMainAgent"], "deleted_classes": ["FlueHothAgent"] }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandbox", "class_name": "HothSandbox" }]
  },
  // placement stays "smart" (default) — "targeted" breaks outboundByHost
  // header injection (sandbox-sdk#661, plan §7).
  "containers": [
    {
      "class_name": "HothSandbox",
      "image": "./Dockerfile",
      // Build context = repo root so the image can COPY the shared semantius
      // CLI from ../linux-x64/ (single binary, no per-backend duplication).
      // Kept small by the repo-root .dockerignore.
      "image_build_context": "..",
      "instance_type": "lite"
    }
  ],
  "kv_namespaces": [
    { "binding": "STORE", "id": "6799aa42675b47148d246feda057a0e5" }
  ],
  // Workers AI binding — required when LLM_PROVIDER=cloudflare (no API key needed).
  "ai": { "binding": "AI" },
  "vars": {
    // LLM settings: provider cloudflare | openrouter | custom ("custom" also
    // requires LLM_BASE_URL). The API key is the LLM_API_KEY secret
    // (.dev.vars locally, wrangler secret put when deployed).
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "deepseek/deepseek-v4-flash",
    // Braintrust tracing (src/braintrust.ts): traces land in this project.
    // The API key is the BRAINTRUST_API_KEY secret (.dev.vars locally,
    // wrangler secret put when deployed) — never a vars value. No key = no export.
    "BRAINTRUST_PROJECT_NAME": "hoth-poc",
    // Arize AX tracing (src/otel.ts): traces land in this Arize project.
    // ARIZE_SPACE_ID + ARIZE_API_KEY are secrets (.dev.vars locally,
    // wrangler secret put when deployed). No secrets = no export.
    "ARIZE_PROJECT_NAME": "hoth-poc",
    // Langfuse tracing (src/otel.ts): OTLP endpoint region. The project is
    // selected by the LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY secrets
    // (.dev.vars locally, wrangler secret put when deployed). No keys = no export.
    "LANGFUSE_BASE_URL": "https://us.cloud.langfuse.com"
  }
}
