# Semantius test credentials for the scripts/ tools — copy to `.env` (gitignored)
# and fill in. Used by `pnpm mint-token`, chat-probe.mjs, and the acceptance
# suite's identity checks to mint the `<org>:<jwt>` token the chat gate requires
# (see README "User identity"). NEVER commit the real values.
SEMANTIUS_API_KEY=sk-...
SEMANTIUS_ORG=your-org-slug

# OPTIONAL, acceptance only: a live better-auth session cookie VALUE
# (`<token>.<signature>` — the value, not `name=value`), copied from a browser
# signed in to the Semantius app. Nothing here can mint one, so the suite's
# [cookie] block is skipped without it. Read as an ENV VAR by
# scripts/acceptance.mjs, not through .env — pass it on the command line:
#   SEMANTIUS_SESSION_COOKIE=<value> API_TOKEN=<key> pnpm acceptance
# SEMANTIUS_SESSION_COOKIE=
